def hisoblash(a, b):
    print(f"\na = {a} va b = {b} uchun hisoblash natijalari:\n")
    print(f"1. ({a} + {b})² = {a + b}² = {(a + b)**2}")
    print(f"2. ({a} - {b})² = {a - b}² = {(a - b)**2}")
    print(f"3. {a}² - {b}² = ({a} - {b})({a} + {b}) = {a**2 - b**2}")
    print(f"4. ({a} + {b})³ = {a + b}³ = {(a + b)**3}")
    print(f"5. ({a} - {b})³ = {a - b}³ = {(a - b)**3}")
    print(f"6. {a}³ + {b}³ = {a**3 + b**3}")
    print(f"7. {a}³ - {b}³ = {a**3 - b**3}")

